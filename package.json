{
  "name": "opencode-gearbox",
  "version": "0.0.0",
  "description": "Gearbox for OpenCode: picks the reasoning effort and model for every prompt and every subagent.",
  "keywords": [
    "opencode-plugin",
    "opencode",
    "reasoning-effort",
    "model-routing",
    "ai-agents",
    "llm",
    "token-efficiency"
  ],
  "license": "MIT",
  "author": {
    "name": "Miguel Martens",
    "url": "https://github.com/miguelmartens"
  },
  "homepage": "https://github.com/miguelmartens/opencode-gearbox",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/miguelmartens/opencode-gearbox.git"
  },
  "bugs": {
    "url": "https://github.com/miguelmartens/opencode-gearbox/issues"
  },
  "type": "module",
  "exports": {
    ".": "./src/server/index.ts",
    "./tui": "./src/tui/index.tsx",
    "./rpc": "./src/rpc.ts"
  },
  "files": [
    "src",
    "bench",
    "NOTICE.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "prepare": "git config core.hooksPath .githooks",
    "test": "bun test",
    "format": "bun fmt --no-script",
    "format:check": "bun fmt --check --no-script",
    "check": "bun run format:check && bun test"
  },
  "packageManager": "bun@1.4.4",
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@opencode/plugin": "latest"
  },
  "peerDependencies": {
    "@opentui/core": ">=0.8.1",
    "@opentui/solid": ">=0.8.1",
    "solid-js": ">=1.9.0"
  },
  "peerDependenciesMeta": {
    "@opentui/core": {
      "optional": true
    },
    "@opentui/solid": {
      "optional": true
    },
    "solid-js": {
      "optional": true
    }
  }
}
